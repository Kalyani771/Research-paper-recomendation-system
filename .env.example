# Copy this file to ".env" and fill in real values. Never commit the real .env file.

# Flask
FLASK_SECRET_KEY=helloworldsay_123_456
FLASK_ENV=development
FLASK_DEBUG=1

# IEEE Xplore Open API key (optional).
# Get one at: https://developer.ieee.org/
# If left blank, the app automatically falls back to the free Crossref API
# for metadata, and clearly labels those results as "Crossref (fallback)"
# instead of "IEEE Xplore (verified)".
IEEE_API_KEY=

# Path to the dataset CSV. Defaults to the bundled demo dataset if not set.
PAPERS_CSV_PATH=data/arxiv_papers.csv

# Sentence-transformers model name. all-MiniLM-L6-v2 is required by the spec.
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Optional: Semantic Scholar API key (https://www.semanticscholar.org/product/api).
# Without one, Semantic Scholar searches are often rate-limited (HTTP 429).
SEMANTIC_SCHOLAR_API_KEY=

# Number of recommendations shown, and candidates fetched per live platform.
TOP_K=10
LIVE_RESULTS_PER_PLATFORM=20
